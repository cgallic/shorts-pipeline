# shorts-pipeline — environment variables
# Copy to .env and fill in. .env is gitignored.

# ─── Runtime root ─────────────────────────────────────────────────────────────
# All working state (output/, forehead-source/, music-pools/, history/, logs/)
# lives under this root. The systemd unit cd's here.
SHORTS_PIPELINE_ROOT=/srv/shorts-pipeline

# Directory holding channel YAML configs. Each *.yaml in here defines one channel.
SHORTS_CHANNELS_DIR=/srv/shorts-pipeline/channels

# ─── LLM (Ollama) ─────────────────────────────────────────────────────────────
# The Qwen client posts to {OLLAMA_URL}/api/generate.
# For a local Ollama, use http://localhost:11434. For a LAN host, use that IP/hostname.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# ─── ElevenLabs (only needed if you generate music pools via this repo's
# generate_music_pool.py, OR if you enable mascot TTS in a later phase) ───────
ELEVENLABS_API_KEY=

# ─── Optional: caption-validator hook ────────────────────────────────────────
# Dotted path to a callable `fn(text: str) -> CheckResult` for brand-voice linting.
# Leave blank to disable. See docs/architecture.md → "Caption validation hook".
SHORTS_CAPTION_VALIDATOR=
